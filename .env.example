# ==============================================================
# Plantilla de credenciales del proyecto KOPERA
# ==============================================================
# Para usarlo:
#
#     cp .env.example .env
#
# y completa los valores. Los que se dejan entrecomillados se pueden
# copiar tal cual: tanto python-dotenv como Docker Compose les quitan
# las comillas. Entrecomilla SIEMPRE las contrasenas: pueden llevar
# caracteres especiales como # o $ que, sin comillas, se interpretarian
# como comentario o como variable.
#
# ----------------------------------------------------------------
# ORACLE: la fuente de verdad (Evaluaciones 2 y 3)
# ----------------------------------------------------------------
# El usuario y la contrasena los crea el script de administracion.
# la plantilla es
# Kopera/procedimiento_pl-sql/CreacionUsuarios.sql.example.
#
# ORACLE_USER va con el valor literal: es el nombre del esquema, no un
# dato sensible, y tiene que coincidir con el usuario que crea el
# script de administracion.
ORACLE_USER=ADMIN_PROYECTO
ORACLE_PASSWORD="cambia_esta_contrasena"
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1

# ----------------------------------------------------------------
# MONGODB ATLAS: el destino de la migracion (Evaluacion 3)
# ----------------------------------------------------------------
# La URI sale del panel de Atlas -> Connect -> Drivers -> Connection
# String. El cluster debe ser del tier gratuito M0.
MONGODB_URI="mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net"

# Nombre de la base donde vive la coleccion migrada. Es el valor por
# defecto de config.py: cambialo solo si tu proyecto de Atlas usa otro.
MONGODB_DATABASE=kopera
